# ============================================================
# Deutsche Welt Backend — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git!
# ============================================================

# Django
SECRET_KEY=django-insecure-deutsche-welt-herrkhalid-secret-key-2026
DEBUG=True
ALLOWED_HOSTS=*

# Database (leave blank to use SQLite)
# DATABASE_URL=postgres://user:pass@localhost:5432/deutschewelt

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=1

# Bunny Stream
BUNNY_API_KEY=your-bunny-api-key-here
BUNNY_LIBRARY_ID=your-library-id-here
BUNNY_STREAM_CDN_HOSTNAME=your-cdn-hostname.b-cdn.net
BUNNY_TOKEN_AUTH_KEY=your-token-auth-key-here

# Google Sign-In
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Apple Sign-In
APPLE_APP_BUNDLE_ID=com.yourapp.deutschewelt

# Email (SMTP) for OTP / Forgot Password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=Deutsch Welt <your-email@gmail.com>
