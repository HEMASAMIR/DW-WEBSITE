# Copy to .env.local and adjust.

# Django backend the site proxies /api/* and /media/* to (server-side, no CORS needed).
# Default: https://py.deutschewelt.academy — for the local Django stub use http://127.0.0.1:8000
BACKEND_URL=https://py.deutschewelt.academy

# Optional: call a backend directly from the browser instead of via the proxy (needs CORS on the backend).
# NEXT_PUBLIC_API_URL=

# Server-only account (NOT NEXT_PUBLIC_) the site uses to show the real levels & books catalog
# to visitors who are not logged in. Use a dedicated account with NO subscriptions.
CATALOG_ACCOUNT_EMAIL=
CATALOG_ACCOUNT_PASSWORD=

# Default WhatsApp number until one is saved from the dashboard (Contact & payment)
NEXT_PUBLIC_WHATSAPP_NUMBER=2010552287454

# Optional: Google OAuth *Web* Client ID — enables the "Continue with Google" button.
# Must be the SAME value as GOOGLE_CLIENT_ID on the backend (it verifies the token's audience).
# In Google Cloud Console add the site's URLs to "Authorized JavaScript origins"
# (e.g. https://deutschewelt.academy and http://localhost:3000). Rebuild after changing it.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional: Google Analytics 4 measurement ID (G-XXXXXXX). Not loaded on /admin. Rebuild after changing it.
NEXT_PUBLIC_GA_ID=
