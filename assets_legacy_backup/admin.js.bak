/**
 * DEUTSCHE WELT AKADEMIE - ADMIN DASHBOARD & SECURE AUTHENTICATION ENGINE
 * Complete Control Panel, Token-based Django DRF Auth, KPI Analytics, CRUD & CSV Export
 */

class DeutscheWeltAdmin {
  constructor() {
    this.token = localStorage.getItem('dw_admin_token') || sessionStorage.getItem('dw_admin_token') || null;
    this.user = JSON.parse(localStorage.getItem('dw_admin_user') || sessionStorage.getItem('dw_admin_user') || 'null');
    this.isAuthenticated = !!this.token || sessionStorage.getItem('dw_admin_logged') === 'true';
    this.activeTab = 'overview';
    this.init();
  }

  init() {
    this.setupEventListeners();
    this.checkSession();
  }

  async checkSession() {
    // 1. Verify Django DRF Token if present
    if (this.token) {
      try {
        const response = await fetch('/api/auth/me/', {
          method: 'GET',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Token ${this.token}`
          }
        });

        if (response.ok) {
          const data = await response.json();
          this.user = data.user;
          this.isAuthenticated = true;
          this.updateUserHeaderUI();
          if (sessionStorage.getItem('dw_admin_logged') === 'true') {
            this.showDashboard();
          }
          return;
        } else if (response.status === 401) {
          // Token expired or invalid
          this.logout(true);
          return;
        }
      } catch (err) {
        console.warn('Backend server offline during session check. Proceeding with stored state.');
      }
    }

    // 2. Legacy / Offline Session fallback check
    const isLogged = sessionStorage.getItem('dw_admin_logged');
    if (isLogged === 'true') {
      this.isAuthenticated = true;
      this.updateUserHeaderUI();
      this.showDashboard();
    }
  }

  updateUserHeaderUI() {
    const userTitleEl = document.getElementById('adminHeaderUserTitle');
    if (userTitleEl && this.user) {
      userTitleEl.innerHTML = `أهلاً بك يا ${this.user.full_name || 'هير خالد'} • <span style="color:#d97706; font-weight:700;">${this.user.role || 'مشرف النظام'}</span>`;
    }
  }

  openAdminPortal() {
    const modal = document.getElementById('adminPortalModal');
    if (!modal) return;
    modal.classList.add('active');

    if (!this.isAuthenticated) {
      document.getElementById('adminAuthOverlay').style.display = 'flex';
      document.getElementById('adminDashboardContainer').style.display = 'none';
      const userInput = document.getElementById('adminUsernameInput');
      if (userInput) userInput.focus();
    } else {
      this.showDashboard();
    }
  }

  togglePinVisibility() {
    const input = document.getElementById('adminPinInput');
    const icon = document.getElementById('authPwdToggleIcon');
    if (!input || !icon) return;
    if (input.type === 'password') {
      input.type = 'text';
      icon.className = 'fas fa-eye-slash';
    } else {
      input.type = 'password';
      icon.className = 'fas fa-eye';
    }
  }

  closeAdminPortal() {
    const modal = document.getElementById('adminPortalModal');
    if (modal) modal.classList.remove('active');
  }

  showAuthAlert(message, type = 'error') {
    const alertEl = document.getElementById('adminAuthAlert');
    if (!alertEl) return;
    alertEl.className = `auth-alert-banner ${type}`;
    alertEl.innerHTML = `<i class="fas fa-${type === 'error' ? 'exclamation-circle' : 'check-circle'}"></i> <span>${message}</span>`;
    alertEl.style.display = 'flex';
  }

  clearAuthAlert() {
    const alertEl = document.getElementById('adminAuthAlert');
    if (alertEl) alertEl.style.display = 'none';
  }

  async login(e) {
    if (e) e.preventDefault();
    this.clearAuthAlert();

    const usernameInput = document.getElementById('adminUsernameInput');
    const pinInput = document.getElementById('adminPinInput');
    const rememberMeInput = document.getElementById('adminRememberMe');
    const submitBtn = document.getElementById('adminAuthSubmitBtn');
    const btnIcon = document.getElementById('authBtnIcon');
    const btnText = document.getElementById('authBtnText');
    const card = document.getElementById('adminAuthCard');

    const username = (usernameInput?.value || '').trim();
    const password = (pinInput?.value || '').trim();
    const rememberMe = rememberMeInput ? rememberMeInput.checked : true;

    if (!username || !password) {
      this.showAuthAlert('يرجى إدخال اسم المستخدم وكلمة المرور كامليْن!');
      return;
    }

    // Set Loading state
    if (submitBtn) submitBtn.classList.add('loading');
    if (btnIcon) btnIcon.className = 'fas fa-spinner fa-spin';
    if (btnText) btnText.innerText = 'جارٍ التحقق الأمني...';

    try {
      // 1. Attempt Backend API Login via Django DRF
      const response = await fetch('/api/auth/login/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ username, password })
      });

      const data = await response.json();

      if (response.ok && data.status === 'success') {
        this.token = data.token;
        this.user = data.user;
        this.isAuthenticated = true;

        const storage = rememberMe ? localStorage : sessionStorage;
        storage.setItem('dw_admin_token', this.token);
        storage.setItem('dw_admin_user', JSON.stringify(this.user));
        sessionStorage.setItem('dw_admin_logged', 'true');

        if (pinInput) pinInput.value = '';
        this.updateUserHeaderUI();
        this.showDashboard();
        window.dwApp.showToast(`مرحباً بك يا ${this.user.full_name || username} في لوحة التحكم! 👑`, 'success');
        return;
      } else {
        // Backend returned authorization failure
        this.triggerCardShake(card);
        this.showAuthAlert(data.error || 'اسم المستخدم أو كلمة المرور غير صحيحة!');
        if (window.dwApp) window.dwApp.showToast('فشل الدخول! تحقق من البيانات.', 'error');
        return;
      }
    } catch (err) {
      // 2. Offline / Fallback Local Dev Mode handling if Django server is not reachable
      console.log('Network request to Django API failed. Evaluating local fallback auth...');
      
      const isFallbackValid = (username === 'admin' || username === 'khaled') && 
                            (password === 'admin' || password === 'dw2024' || password === 'khaled123');

      if (isFallbackValid) {
        this.isAuthenticated = true;
        this.user = {
          username: username,
          full_name: 'هير خالد',
          role: 'مشرف النظام (وضع محلي)'
        };

        const storage = rememberMe ? localStorage : sessionStorage;
        storage.setItem('dw_admin_user', JSON.stringify(this.user));
        sessionStorage.setItem('dw_admin_logged', 'true');

        if (pinInput) pinInput.value = '';
        this.updateUserHeaderUI();
        this.showDashboard();
        window.dwApp.showToast('تم الدخول بنجاح! 👑 (وضع المعاينة المحلية)', 'success');
      } else {
        this.triggerCardShake(card);
        this.showAuthAlert('اسم المستخدم أو كلمة المرور غير صحيحة!');
      }
    } finally {
      // Reset button loading state
      if (submitBtn) submitBtn.classList.remove('loading');
      if (btnIcon) btnIcon.className = 'fas fa-sign-in-alt';
      if (btnText) btnText.innerText = 'دخول لوحة التحكم';
    }
  }

  triggerCardShake(card) {
    if (!card) return;
    card.classList.remove('auth-shake-error');
    void card.offsetWidth; // trigger reflow
    card.classList.add('auth-shake-error');
    setTimeout(() => card.classList.remove('auth-shake-error'), 650);
  }

  async logout(silent = false) {
    if (this.token) {
      try {
        await fetch('/api/auth/logout/', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Token ${this.token}`
          }
        });
      } catch (e) {
        console.warn('Logout API notification failed:', e);
      }
    }

    this.token = null;
    this.user = null;
    this.isAuthenticated = false;

    localStorage.removeItem('dw_admin_token');
    localStorage.removeItem('dw_admin_user');
    sessionStorage.removeItem('dw_admin_token');
    sessionStorage.removeItem('dw_admin_user');
    sessionStorage.removeItem('dw_admin_logged');

    document.getElementById('adminAuthOverlay').style.display = 'flex';
    document.getElementById('adminDashboardContainer').style.display = 'none';

    if (!silent && window.dwApp) {
      window.dwApp.showToast('تم تسجيل الخروج بنجاح من لوحة التحكم.', 'info');
    } else if (silent && window.dwApp) {
      window.dwApp.showToast('انتهت صلاحية الجلسة. يرجى تسجيل الدخول مجدداً.', 'warning');
    }
  }

  async fetchWithAuth(url, options = {}) {
    options.headers = options.headers || {};
    if (this.token) {
      options.headers['Authorization'] = `Token ${this.token}`;
    }

    try {
      const response = await fetch(url, options);
      if (response.status === 401) {
        this.logout(true);
        throw new Error('Unauthorized');
      }
      return response;
    } catch (err) {
      throw err;
    }
  }

  showDashboard() {
    document.getElementById('adminAuthOverlay').style.display = 'none';
    document.getElementById('adminDashboardContainer').style.display = 'flex';
    this.switchTab(this.activeTab);
    this.refreshAllData();
  }

  switchTab(tabId) {
    this.activeTab = tabId;
    document.querySelectorAll('.admin-nav-btn').forEach(btn => {
      btn.classList.toggle('active', btn.getAttribute('data-tab') === tabId);
    });

    document.querySelectorAll('.admin-tab-pane').forEach(pane => {
      pane.classList.remove('active');
    });

    const targetPane = document.getElementById(`tab-${tabId}`);
    if (targetPane) {
      targetPane.classList.add('active');
    }

    if (tabId === 'overview') this.renderOverview();
    if (tabId === 'courses') this.renderCoursesTable();
    if (tabId === 'registrations') this.renderRegistrationsTable();
    if (tabId === 'books') this.renderBookOrdersTable();
    if (tabId === 'analytics') this.renderAnalyticsCharts();
    if (tabId === 'branches') this.renderBranchesAdmin();
  }

  setupEventListeners() {
    // Nav buttons
    document.querySelectorAll('.admin-nav-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const tab = btn.getAttribute('data-tab');
        this.switchTab(tab);
      });
    });

    // Quick admin open buttons in navbar & footer
    const quickBtns = document.querySelectorAll('#adminPortalBtn, #adminQuickBtn, .admin-quick-btn');
    quickBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        this.openAdminPortal();
      });
    });
    const footerAdminBtn = document.getElementById('footerAdminBtn');
    if (footerAdminBtn) {
      footerAdminBtn.addEventListener('click', (e) => {
        e.preventDefault();
        this.openAdminPortal();
      });
    }

    // Seed mock data if empty
    this.ensureInitialData();
  }

  ensureInitialData() {
    const regs = localStorage.getItem('dw_registrations');
    if (!regs) {
      const mockRegs = [
        { id: 'REG-101', name: 'أحمد محمود العوضي', phone: '01012345678', email: 'ahmed.awadi@example.com', course: 'المستوى الذهبي للسفر والعمل (B1)', payment: 'فودافون كاش', notes: 'بدأت بالمحاضرة الأولى عبر المنصة ومحتاج تفعيل الدعم', date: '2026-08-19 14:30', status: 'confirmed' },
        { id: 'REG-102', name: 'سارة خالد الدسوقي', phone: '01198765432', email: 'sara.desouky@example.com', course: 'كورس تأهيل سوق العمل & الكول سنتر الألماني', payment: 'إنستاباي', notes: 'تحضير لمقابلة Concentrix', date: '2026-08-19 18:15', status: 'confirmed' },
        { id: 'REG-103', name: 'د. محمود حسن عبدالفتاح', phone: '01234567890', email: 'dr.mahmoud@example.com', course: 'كورس اللغة الألمانية الطبية (للأطباء والتمريض)', payment: 'تحويل بنكي', notes: 'تجهيز لمعادلة الأطباء في ألمانيا', date: '2026-08-20 02:00', status: 'pending' },
        { id: 'REG-104', name: 'مريم إبراهيم خليل', phone: '01555556666', email: 'mariam.khalil@example.com', course: 'كورس المستوى التأسيسي الشامل (A1)', payment: 'فودافون كاش', notes: 'مبتدئة تماماً من الصفر', date: '2026-08-20 03:45', status: 'pending' }
      ];
      localStorage.setItem('dw_registrations', JSON.stringify(mockRegs));
    }

    const orders = localStorage.getItem('dw_book_orders');
    if (!orders) {
      const mockOrders = [
        { id: 'BORD-201', name: 'كريم طارق حسني', phone: '01099887766', address: 'مدينة نصر - القاهرة', bookName: 'سلسلة كتب دويتشه فيلت (A1 + A2 + B1)', quantity: 1, total: 500, date: '2026-08-19 16:20', status: 'shipped' },
        { id: 'BORD-202', name: 'نوران حسام الدين', phone: '01222334455', address: 'سموحة - الإسكندرية', bookName: 'كتاب التأهيل والامتحانات الدولية (B1)', quantity: 2, total: 1000, date: '2026-08-19 21:10', status: 'pending' }
      ];
      localStorage.setItem('dw_book_orders', JSON.stringify(mockOrders));
    }
  }

  refreshAllData() {
    this.renderOverview();
    this.renderCoursesTable();
    this.renderRegistrationsTable();
    this.renderBookOrdersTable();
    this.updateBadges();
  }

  getRegistrations() {
    return JSON.parse(localStorage.getItem('dw_registrations') || '[]');
  }

  getBookOrders() {
    return JSON.parse(localStorage.getItem('dw_book_orders') || '[]');
  }

  updateBadges() {
    const regs = this.getRegistrations();
    const pendingRegs = regs.filter(r => r.status === 'pending').length;
    const badgeRegs = document.getElementById('adminRegsCountBadge');
    if (badgeRegs) badgeRegs.innerText = pendingRegs;

    const orders = this.getBookOrders();
    const pendingOrders = orders.filter(o => o.status === 'pending').length;
    const badgeOrders = document.getElementById('adminOrdersCountBadge');
    if (badgeOrders) badgeOrders.innerText = pendingOrders;
  }

  // 1. Overview Tab
  renderOverview() {
    const regs = this.getRegistrations();
    const orders = this.getBookOrders();
    const courses = window.dwApp ? window.dwApp.courses : [];

    // Calculate revenue
    let courseRevenue = 0;
    regs.forEach(r => {
      if (r.status === 'confirmed' || r.status === 'paid') {
        const found = courses.find(c => c.title === r.course);
        courseRevenue += found ? found.price : 1500;
      }
    });

    let booksRevenue = 0;
    orders.forEach(o => {
      if (o.status !== 'cancelled') {
        booksRevenue += (o.total || 500);
      }
    });

    const totalRevenue = courseRevenue + booksRevenue;
    const activeStudents = 5000 + regs.filter(r => r.status === 'confirmed').length;

    // KPI Elements
    document.getElementById('kpiTotalRevenue').innerText = `${totalRevenue.toLocaleString()} جنيه`;
    document.getElementById('kpiTotalStudents').innerText = `${activeStudents.toLocaleString()} طالب`;
    document.getElementById('kpiNewRegs').innerText = `${regs.length} حجز`;
    document.getElementById('kpiBookOrders').innerText = `${orders.length} طلب`;

    // Recent Registrations Preview
    const recentWrap = document.getElementById('adminRecentRegsTableBody');
    if (recentWrap) {
      recentWrap.innerHTML = regs.slice(0, 5).map(r => `
        <tr>
          <td><strong>${r.name}</strong></td>
          <td>${r.course}</td>
          <td><span class="status-badge ${r.status}">${this.getStatusLabel(r.status)}</span></td>
          <td>${r.date}</td>
          <td>
            <button class="tbl-act-btn wa" title="مراسلة واتساب" onclick="window.dwAdmin.chatWhatsApp('${r.phone}', '${r.name}', '${r.course}')">
              <i class="fab fa-whatsapp"></i>
            </button>
          </td>
        </tr>
      `).join('');
    }
  }

  getStatusLabel(status) {
    switch (status) {
      case 'confirmed': return 'مؤكد ✅';
      case 'pending': return 'قيد الانتظار ⏳';
      case 'paid': return 'تم الدفع 💰';
      case 'cancelled': return 'ملغي ❌';
      case 'shipped': return 'تم الشحن 🚚';
      default: return status;
    }
  }

  // 2. Courses CRUD Table
  renderCoursesTable() {
    const tableBody = document.getElementById('adminCoursesTableBody');
    if (!tableBody || !window.dwApp) return;

    const courses = window.dwApp.courses;
    tableBody.innerHTML = courses.map(c => `
      <tr>
        <td><strong style="color:var(--primary-light);">${c.level}</strong></td>
        <td><strong>${c.title}</strong></td>
        <td>${c.hours} (${c.lectures})</td>
        <td><strong style="color:var(--gold-light);">${c.price} ${c.currency}</strong></td>
        <td>
          <span class="status-badge ${c.status === 'open' ? 'confirmed' : 'cancelled'}">
            ${c.status === 'open' ? 'متاح للتسجيل' : 'قريباً'}
          </span>
        </td>
        <td>
          <div class="table-actions">
            <button class="tbl-act-btn" title="تعديل السعر والحالة" onclick="window.dwAdmin.openEditCourseModal('${c.id}')">
              <i class="fas fa-edit"></i>
            </button>
            <button class="tbl-act-btn del" title="حذف الكورس" onclick="window.dwAdmin.deleteCourse('${c.id}')">
              <i class="fas fa-trash"></i>
            </button>
          </div>
        </td>
      </tr>
    `).join('');
  }

  openAddCourseModal() {
    const modal = document.getElementById('adminAddCourseModal');
    if (modal) modal.classList.add('active');
  }

  closeAddCourseModal() {
    const modal = document.getElementById('adminAddCourseModal');
    if (modal) modal.classList.remove('active');
  }

  handleAddCourse(e) {
    e.preventDefault();
    const form = e.target;
    const newCourse = {
      id: 'course-' + Date.now(),
      level: form.courseLevel.value,
      category: form.courseCategory.value,
      title: form.courseTitle.value,
      subtitle: form.courseSubtitle.value,
      hours: form.courseHours.value + ' ساعة',
      lectures: form.courseLectures.value + ' محاضرة',
      duration: form.courseDuration.value,
      price: parseInt(form.coursePrice.value),
      currency: 'EGP',
      status: form.courseStatus.value,
      featured: form.courseFeatured.checked,
      syllabus: [
        'أساسيات وقواعد المستوى المكثف',
        'محادثات وتمارين النطق الصوتي الصحيح',
        'تأهيل لامتحانات ومقابلات سوق العمل'
      ],
      audioSample: 'Willkommen zum neuen Kurs bei Deutsche Welt!'
    };

    const courses = [...window.dwApp.courses, newCourse];
    window.dwApp.saveCourses(courses);

    this.closeAddCourseModal();
    this.renderCoursesTable();
    window.dwApp.showToast('تمت إضافة الكورس الجديد بنجاح! 🎉', 'success');
    form.reset();
  }

  openEditCourseModal(courseId) {
    const course = window.dwApp.courses.find(c => c.id === courseId);
    if (!course) return;

    const newPrice = prompt(`تعديل سعر كورس (${course.title}):`, course.price);
    if (newPrice !== null && !isNaN(newPrice)) {
      course.price = parseInt(newPrice);
      window.dwApp.saveCourses(window.dwApp.courses);
      this.renderCoursesTable();
      window.dwApp.showToast('تم تحديث سعر الكورس بنجاح!', 'success');
    }
  }

  deleteCourse(courseId) {
    if (confirm('هل أنت متأكد من رغبتك في حذف هذا الكورس؟')) {
      const courses = window.dwApp.courses.filter(c => c.id !== courseId);
      window.dwApp.saveCourses(courses);
      this.renderCoursesTable();
      window.dwApp.showToast('تم حذف الكورس بنجاح.', 'info');
    }
  }

  // 3. Registrations Management
  renderRegistrationsTable() {
    const tableBody = document.getElementById('adminRegistrationsTableBody');
    if (!tableBody) return;

    const regs = this.getRegistrations();
    tableBody.innerHTML = regs.map(r => `
      <tr>
        <td><strong>${r.id}</strong></td>
        <td><strong>${r.name}</strong></td>
        <td><a href="tel:${r.phone}" style="color:var(--primary-light); text-decoration:none;">${r.phone}</a></td>
        <td>${r.course}</td>
        <td>${r.payment}</td>
        <td>
          <select class="form-select" style="padding:4px 8px; font-size:0.8rem;" onchange="window.dwAdmin.updateRegStatus('${r.id}', this.value)">
            <option value="pending" ${r.status === 'pending' ? 'selected' : ''}>قيد الانتظار ⏳</option>
            <option value="confirmed" ${r.status === 'confirmed' ? 'selected' : ''}>مؤكد ✅</option>
            <option value="paid" ${r.status === 'paid' ? 'selected' : ''}>تم الدفع 💰</option>
            <option value="cancelled" ${r.status === 'cancelled' ? 'selected' : ''}>ملغي ❌</option>
          </select>
        </td>
        <td>
          <div class="table-actions">
            <button class="tbl-act-btn wa" title="محادثة واتساب مباشرة" onclick="window.dwAdmin.chatWhatsApp('${r.phone}', '${r.name}', '${r.course}')">
              <i class="fab fa-whatsapp"></i>
            </button>
            <button class="tbl-act-btn del" title="حذف الحجز" onclick="window.dwAdmin.deleteRegistration('${r.id}')">
              <i class="fas fa-trash"></i>
            </button>
          </div>
        </td>
      </tr>
    `).join('');
  }

  updateRegStatus(regId, newStatus) {
    const regs = this.getRegistrations();
    const target = regs.find(r => r.id === regId);
    if (target) {
      target.status = newStatus;
      localStorage.setItem('dw_registrations', JSON.stringify(regs));
      this.updateBadges();
      this.renderOverview();
      window.dwApp.showToast(`تم تغيير حالة الحجز إلى: ${this.getStatusLabel(newStatus)}`, 'success');
    }
  }

  chatWhatsApp(phone, studentName, courseName) {
    let cleanPhone = phone.replace(/[^0-9]/g, '');
    if (cleanPhone.startsWith('01')) {
      cleanPhone = '2' + cleanPhone;
    }
    const msg = encodeURIComponent(`مرحباً أستاذ(ة) ${studentName} 👋\nمعاك هير خالد وإدارة أكاديمية دويتشه فيلت 🇩🇪\nبخصوص تسجيلك معنا في *${courseName}*، يسعدنا تأكيد التفاصيل وتحديد موعد أول محاضرة!`);
    window.open(`https://wa.me/${cleanPhone}?text=${msg}`, '_blank');
  }

  deleteRegistration(regId) {
    if (confirm('هل أنت متأكد من حذف هذا الحجز نهائياً؟')) {
      const regs = this.getRegistrations().filter(r => r.id !== regId);
      localStorage.setItem('dw_registrations', JSON.stringify(regs));
      this.renderRegistrationsTable();
      this.renderOverview();
      this.updateBadges();
      window.dwApp.showToast('تم حذف الحجز بنجاح.', 'info');
    }
  }

  exportRegistrationsCSV() {
    const regs = this.getRegistrations();
    let csv = "ID,Name,Phone,Email,Course,Payment,Status,Date\n";
    regs.forEach(r => {
      csv += `"${r.id}","${r.name}","${r.phone}","${r.email || ''}","${r.course}","${r.payment}","${r.status}","${r.date}"\n`;
    });

    const blob = new Blob(["\uFEFF" + csv], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement("a");
    link.setAttribute("href", url);
    link.setAttribute("download", `Deutsche_Welt_Students_${Date.now()}.csv`);
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    window.dwApp.showToast('📥 تم تصدير بيانات الطلاب كملف CSV بنجاح!', 'success');
  }

  // 4. Book Orders Management
  renderBookOrdersTable() {
    const tableBody = document.getElementById('adminBookOrdersTableBody');
    if (!tableBody) return;

    const orders = this.getBookOrders();
    tableBody.innerHTML = orders.map(o => `
      <tr>
        <td><strong>${o.id}</strong></td>
        <td><strong>${o.name}</strong></td>
        <td><a href="tel:${o.phone}" style="color:var(--primary-light); text-decoration:none;">${o.phone}</a></td>
        <td>${o.address}</td>
        <td>${o.bookName} (x${o.quantity})</td>
        <td><strong style="color:var(--gold-light);">${o.total} جنيه</strong></td>
        <td>
          <select class="form-select" style="padding:4px 8px; font-size:0.8rem;" onchange="window.dwAdmin.updateOrderStatus('${o.id}', this.value)">
            <option value="pending" ${o.status === 'pending' ? 'selected' : ''}>قيد التجهيز ⏳</option>
            <option value="shipped" ${o.status === 'shipped' ? 'selected' : ''}>تم الشحن 🚚</option>
            <option value="delivered" ${o.status === 'delivered' ? 'selected' : ''}>تم الاستلام ✅</option>
            <option value="cancelled" ${o.status === 'cancelled' ? 'selected' : ''}>ملغي ❌</option>
          </select>
        </td>
        <td>
          <button class="tbl-act-btn wa" title="محادثة واتساب" onclick="window.dwAdmin.chatWhatsApp('${o.phone}', '${o.name}', 'طلب كتاب ${o.bookName}')">
            <i class="fab fa-whatsapp"></i>
          </button>
        </td>
      </tr>
    `).join('');
  }

  updateOrderStatus(orderId, newStatus) {
    const orders = this.getBookOrders();
    const target = orders.find(o => o.id === orderId);
    if (target) {
      target.status = newStatus;
      localStorage.setItem('dw_book_orders', JSON.stringify(orders));
      this.updateBadges();
      this.renderOverview();
      window.dwApp.showToast(`تم تحديث حالة طلب الكتاب: ${newStatus}`, 'success');
    }
  }

  // 5. Canvas Analytics Charts
  renderAnalyticsCharts() {
    const canvas = document.getElementById('adminAnalyticsChart');
    if (!canvas) return;

    const ctx = canvas.getContext('2d');
    canvas.width = canvas.parentElement.clientWidth || 500;
    canvas.height = 260;

    ctx.clearRect(0, 0, canvas.width, canvas.height);

    // Draw Bar Chart for Student Enrollment by Level
    const levels = ['A1', 'A2', 'B1', 'B2', 'Upskilling', 'Medizin'];
    const counts = [180, 140, 210, 95, 160, 75];
    const maxVal = 250;

    const barWidth = 40;
    const gap = (canvas.width - (levels.length * barWidth)) / (levels.length + 1);

    levels.forEach((lvl, i) => {
      const x = gap + i * (barWidth + gap);
      const barHeight = (counts[i] / maxVal) * (canvas.height - 60);
      const y = canvas.height - 35 - barHeight;

      // Bar gradient
      const grad = ctx.createLinearGradient(0, y, 0, y + barHeight);
      grad.addColorStop(0, '#3b82f6');
      grad.addColorStop(1, '#1e3a8a');

      ctx.fillStyle = grad;
      ctx.beginPath();
      ctx.roundRect(x, y, barWidth, barHeight, [6, 6, 0, 0]);
      ctx.fill();

      // Number Label
      ctx.fillStyle = '#f59e0b';
      ctx.font = 'bold 12px Cairo, sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText(counts[i] + ' طالب', x + barWidth / 2, y - 8);

      // Level Label
      ctx.fillStyle = '#94a3b8';
      ctx.fillText(lvl, x + barWidth / 2, canvas.height - 12);
    });
  }

  // ===================== BRANCHES MANAGEMENT =====================
  getBranches() {
    if (window.dwApp) return window.dwApp.loadBranches();
    return JSON.parse(localStorage.getItem('dw_branches_v2') || '[]');
  }

  renderBranchesAdmin() {
    const grid = document.getElementById('adminBranchesGrid');
    if (!grid) return;
    const branches = this.getBranches();
    if (!branches.length) {
      grid.innerHTML = '<p style="text-align:center; color:var(--text-muted); padding:40px;">لا توجد فروع مضافة بعد.</p>';
      return;
    }
    grid.innerHTML = branches.map(b => {
      const isOnline = b.type === 'online';
      return `
        <div class="branch-admin-card">
          <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:10px; margin-bottom:10px;">
            <div>
              <span class="branch-badge ${isOnline ? 'badge-online' : 'badge-physical'}" style="font-size:0.75rem;">${b.badge || ''}</span>
              <h4 style="font-size:1rem; font-weight:800; color:var(--text-heading); margin:6px 0 2px;">${b.name}</h4>
              <span style="font-size:0.8rem; color:var(--text-muted);"><i class="fas fa-location-dot"></i> ${b.city}</span>
            </div>
            <div style="display:flex; gap:6px; flex-shrink:0;">
              <button class="table-btn edit-btn" onclick="window.dwAdmin.editBranch('${b.id}')" title="تعديل"><i class="fas fa-pen"></i></button>
              <button class="table-btn delete-btn" onclick="window.dwAdmin.deleteBranch('${b.id}')" title="حذف"><i class="fas fa-trash"></i></button>
            </div>
          </div>
          <div style="font-size:0.82rem; color:var(--text-body); background:var(--bg-base); border-radius:8px; padding:8px 10px; margin-bottom:8px;">
            <i class="fas fa-map-pin" style="color:var(--brand-blue);"></i> ${(b.address || '').replace(/\n/g, '<br>')}
          </div>
          <a href="${b.mapUrl}" target="_blank" rel="noopener" style="font-size:0.8rem; color:var(--brand-blue); font-weight:700; text-decoration:none;">
            <i class="fas fa-external-link-alt"></i> فتح الموقع
          </a>
        </div>
      `;
    }).join('');
  }

  openAddBranchModal() {
    document.getElementById('branchModalTitle').innerHTML = '<i class="fas fa-map-location-dot"></i> إضافة فرع جديد';
    document.getElementById('branchForm').reset();
    document.getElementById('branchFormId').value = '';
    document.getElementById('adminBranchModal').classList.add('active');
  }

  closeBranchModal() {
    document.getElementById('adminBranchModal').classList.remove('active');
  }

  editBranch(id) {
    const branches = this.getBranches();
    const branch = branches.find(b => b.id === id);
    if (!branch) return;
    const form = document.getElementById('branchForm');
    form.branchId.value = branch.id;
    form.branchName.value = branch.name || '';
    form.branchCity.value = branch.city || '';
    form.branchType.value = branch.type || 'physical';
    form.branchAddress.value = branch.address || '';
    form.branchMapUrl.value = branch.mapUrl || '';
    form.branchBadge.value = branch.badge || '';
    document.getElementById('branchModalTitle').innerHTML = '<i class="fas fa-pen"></i> تعديل الفرع';
    document.getElementById('adminBranchModal').classList.add('active');
  }

  deleteBranch(id) {
    if (!confirm('هل أنت متأكد من حذف هذا الفرع؟')) return;
    let branches = this.getBranches();
    branches = branches.filter(b => b.id !== id);
    localStorage.setItem('dw_branches_v2', JSON.stringify(branches));
    if (window.dwApp) window.dwApp.saveBranches(branches);
    this.renderBranchesAdmin();
    this.showToast('تم حذف الفرع بنجاح', 'success');
  }

  handleSaveBranch(e) {
    e.preventDefault();
    const form = e.target;
    const id = form.branchId.value;
    let branches = this.getBranches();
    const branchData = {
      id: id || 'branch-' + Date.now(),
      name: form.branchName.value.trim(),
      city: form.branchCity.value.trim(),
      type: form.branchType.value,
      address: form.branchAddress.value.trim(),
      mapUrl: form.branchMapUrl.value.trim(),
      badge: form.branchBadge.value.trim(),
      phone: '010552287454'
    };
    if (id) {
      branches = branches.map(b => b.id === id ? branchData : b);
    } else {
      branches.push(branchData);
    }
    localStorage.setItem('dw_branches_v2', JSON.stringify(branches));
    if (window.dwApp) window.dwApp.saveBranches(branches);
    this.closeBranchModal();
    this.renderBranchesAdmin();
    this.showToast(id ? 'تم تعديل الفرع بنجاح ✅' : 'تمت إضافة الفرع بنجاح ✅', 'success');
  }
}

// Instantiate Admin Global
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', () => {
    window.dwAdmin = new DeutscheWeltAdmin();
  });
} else {
  window.dwAdmin = new DeutscheWeltAdmin();
}
